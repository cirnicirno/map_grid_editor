en:{subtitle:"GRID EDITOR FOR MAPS",drop:"[ + ] LOAD MAP<br><small>or drop an image here</small>",gridTitle:"// GRID SETTINGS",cell:"CELL SIZE",zoom:"PREVIEW ZOOM",offsetX:"X OFFSET",offsetY:"Y OFFSET",lineWidth:"LINE WIDTH",color:"COLOR",opacity:"OPACITY",exportTitle:"// IMAGE EXPORT",format:"FORMAT",printTitle:"// TILED PRINT",paper:"PAPER",orientation:"ORIENTATION",portrait:"PORTRAIT",landscape:"LANDSCAPE",dpi:"PIXELS / INCH",margin:"MARGIN, MM",pagePreview:"SHOW PAGES",pdfDownload:"EXPORT PDF",pages:"PAGES",printArea:"PAGE AREA",creatingPdf:"CREATING PDF...",crt:"CRT EFFECT",crtOn:"ON",crtOff:"OFF",download:"EXPORT MAP",reset:"RESET SETTINGS",upload:"WAITING FOR MAP...",choose:"CHOOSE AN IMAGE FILE",error:"LOAD ERROR",prompt:"LOAD A MAP",loaded:"MAP LOADED",cells:"CELLS",exported:"EXPORT COMPLETE",pdfExported:"PDF COMPLETE",invalidPrint:"CHECK PRINT SETTINGS"}};
