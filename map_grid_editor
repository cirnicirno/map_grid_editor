function makePdf(){render();const ps=printSettings();if(!image||!ps||!ps.pages){alert(t("invalidPrint"));return}$("status").textContent=t("creatingPdf");pdfDownload.disabled=true;setTimeout(()=>{try{const objects=[],pageRefs=[];let objectNumber=3;const pageData=[];for(let r=0;r<ps.rows;r++)for(let c=0;c<ps.cols;c++){const sx=c*ps.tileW,sy=r*ps.tileH,sw=Math.min(ps.tileW,canvas.width-sx),sh=Math.min(ps.tileH,canvas.height-sy),slice=document.createElement("canvas");slice.width=sw;slice.height=sh;const sc=slice.getContext("2d");sc.fillStyle="#fff";sc.fillRect(0,0,sw,sh);sc.drawImage(canvas,sx,sy,sw,sh,0,0,sw,sh);const jpg=bytesFromDataUrl(slice.toDataURL("image/jpeg",.94));const imageObj=objectNumber++,contentObj=objectNumber++,pageObj=objectNumber++;pageData.push({jpg,sw,sh,imageObj,contentObj,pageObj});pageRefs.push(`${pageObj} 0 R`)}const kids=pageRefs.join(" ");objects[1]=ascii(`1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n`);objects[2]=ascii(`2 0 obj\n<< /Type /Pages /Kids [${kids}] /Count ${pageData.length} >>\nendobj\n`);for(const p of pageData){const pageW=ps.wMm/25.4*72,pageH=ps.hMm/25.4*72,x=ps.margin/25.4*72,y=pageH-ps.margin/25.4*72-p.sh/ps.dpi*72,w=p.sw/ps.dpi*72,h=p.sh/ps.dpi*72,content=`q\n${w.toFixed(3)} 0 0 ${h.toFixed(3)} ${x.toFixed(3)} ${y.toFixed(3)} cm\n/Im0 Do\nQ\n`,cb=ascii(content);objects[p.imageObj]=concat([ascii(`${p.imageObj} 0 obj\n<< /Type /XObject /Subtype /Image /Width ${p.sw} /Height ${p.sh} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${p.jpg.length} >>\nstream\n`),p.jpg,ascii(`\nendstream\nendobj\n`)]);objects[p.contentObj]=concat([ascii(`${p.contentObj} 0 obj\n<< /Length ${cb.length} >>\nstream\n`),cb,ascii(`endstream\nendobj\n`)]);objects[p.pageObj]=ascii(`${p.pageObj} 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pageW.toFixed(3)} ${pageH.toFixed(3)}] /Resources << /XObject << /Im0 ${p.imageObj} 0 R >> >> /Contents ${p.contentObj} 0 R >>\nendobj\n`)}const header=ascii("%PDF-1.4\n%\xE2\xE3\xCF\xD3\n"),parts=[header],offsets=[0],max=objects.length-1;let pos=header.length;for(let i=1;i<=max;i++){offsets[i]=pos;parts.push(objects[i]);pos+=objects[i].length}const xrefPos=pos;let xref=`xref\n0 ${max+1}\n0000000000 65535 f \n`;for(let i=1;i<=max;i++)xref+=String(offsets[i]).padStart(10,"0")+" 00000 n \n";xref+=`trailer\n<< /Size ${max+1} /Root 1 0 R >>\nstartxref\n${xrefPos}\n%%EOF`;parts.push(ascii(xref));const blob=new Blob(parts,{type:"application/pdf"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=`${sourceName}-grid-${$("paper").value.toUpperCase()}.pdf`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);$("status").textContent=`${t("pdfExported")} // ${ps.pages} ${t("pages")}`}catch(e){console.error(e);alert(t("error"))}finally{pdfDownload.disabled=false}},30)}
$("langBtn").addEventListener("click",()=>{lang=lang==="ru"?"en":"ru";applyLang()});drop.addEventListener("click",()=>file.click());drop.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();file.click()}});file.addEventListener("change",()=>load(file.files[0]));["dragenter","dragover"].forEach(x=>drop.addEventListener(x,e=>{e.preventDefault();drop.classList.add("drag")}));["dragleave","drop"].forEach(x=>drop.addEventListener(x,e=>{e.preventDefault();drop.classList.remove("drag")}));drop.addEventListener("drop",e=>load(e.dataTransfer.files[0]));["cell","zoom","offsetX","offsetY","lineWidth","color","opacity","paper","orientation","margin","pagePreview"].forEach(id=>$(id).addEventListener("input",render));$("printDpi").addEventListener("input",()=>{dpiTouched=true;render()});$("crtBtn").addEventListener("click",()=>{crtOn=!crtOn;updateCrtState()});$("reset").addEventListener("click",()=>{$("cell").value=100;$("zoom").value=100;$("offsetX").value=0;$("offsetY").value=0;$("lineWidth").value=2;$("color").value="#000000";$("opacity").value=55;$("paper").value="a4";$("orientation").value="portrait";$("margin").value=10;$("pagePreview").checked=false;dpiTouched=false;render()});download.addEventListener("click",()=>{render();const mime=$("format").value,ext=mime==="image/jpeg"?"jpg":mime.split("/")[1],a=document.createElement("a");a.download=`${sourceName}-grid.${ext}`;a.href=canvas.toDataURL(mime,mime==="image/png"?undefined:.95);a.click();$("status").textContent=t("exported")});pdfDownload.addEventListener("click",makePdf);applyLang();
})();
