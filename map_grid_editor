<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Map Grid Editor</title>
<style>
:root{color-scheme:dark;--bg:#07100a;--panel:#101b12;--panel2:#152318;--ink:#d8f3c6;--muted:#88a77c;--gold:#d6b85d;--green:#7cff75;--danger:#ff7a6b;--edge:#2e4a33;--shadow:#020603}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#030704;color:var(--ink)}
body{font-family:"Courier New",ui-monospace,monospace;image-rendering:pixelated;overflow-x:hidden}
body.crt::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:999;background:repeating-linear-gradient(to bottom,rgba(255,255,255,.025) 0 1px,rgba(0,0,0,.08) 1px 3px),linear-gradient(90deg,rgba(255,0,0,.018),rgba(0,255,0,.012),rgba(0,0,255,.018));mix-blend-mode:screen}
body.crt::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:998;box-shadow:inset 0 0 100px #000,inset 0 0 24px #000;animation:flicker 8s infinite steps(2,end)}
@keyframes flicker{0%,96%,100%{opacity:.9}97%{opacity:.75}98%{opacity:.98}}
.app{display:grid;grid-template-columns:340px minmax(0,1fr);gap:14px;min-height:100vh;padding:14px;background:radial-gradient(circle at 50% 0,#102716 0,#08120b 45%,#030704 100%)}
.pixel-box{background:var(--panel);border:3px solid #304d35;box-shadow:0 0 0 3px #071009,6px 6px 0 #000;padding:14px;position:relative}
.pixel-box::before{content:"";position:absolute;inset:5px;border:1px solid #1d3422;pointer-events:none}
.sidebar{align-self:start;position:sticky;top:14px;max-height:calc(100vh - 28px);min-width:0;overflow-y:auto;overflow-x:hidden}
.titlebar{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:3px double var(--edge);padding:2px 2px 12px;margin-bottom:12px}.title-actions{display:flex;align-items:center;gap:7px}
h1{font-size:20px;line-height:1.1;letter-spacing:1px;margin:0;color:var(--gold);text-shadow:2px 2px #000}
.flag-btn,.crt-btn{width:48px;height:36px;padding:0;border:2px solid #5e774e;background:#10170e;box-shadow:inset -3px -3px #050805,inset 3px 3px #2d4228;cursor:pointer;font-size:22px;line-height:1}.crt-btn{font-size:17px;color:#71806a}.crt-btn.active{color:var(--green);border-color:var(--green);text-shadow:0 0 7px var(--green)}
.flag-btn:active,.crt-btn:active,.btn:active{transform:translate(2px,2px);box-shadow:none}
.subtitle{margin:0 0 12px;color:var(--muted);font-size:13px}
.section-title{margin:14px 0 8px;color:var(--gold);font-size:12px;letter-spacing:1px;border-bottom:1px dashed #36513a;padding-bottom:4px}
.drop{border:2px dashed #4c6e4d;background:#0a130c;padding:16px 10px;text-align:center;color:var(--muted);cursor:pointer;box-shadow:inset 0 0 0 2px #020503}
.drop.drag{color:var(--green);border-color:var(--green)}
.file-input{position:absolute;left:-9999px}
label{display:block;margin:11px 0 5px;color:#c8deb8;font-size:13px}.value{float:right;color:var(--green)}
input,select{width:100%;font:inherit;color:var(--ink);background:#081009;border:2px solid #304a34;border-radius:0;padding:8px;outline:none;box-shadow:inset 2px 2px #020402}
input:focus,select:focus{border-color:var(--green)}
input[type=range]{appearance:none;height:18px;padding:0;background:#081009}
input[type=range]::-webkit-slider-thumb{appearance:none;width:16px;height:22px;background:var(--gold);border:2px solid #241c05;box-shadow:2px 2px #000;cursor:ew-resize}
input[type=range]::-moz-range-thumb{width:14px;height:20px;border-radius:0;background:var(--gold);border:2px solid #241c05;box-shadow:2px 2px #000}
input[type=color]{height:38px;padding:3px}.row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:9px}.row>*{min-width:0}
.btn{width:100%;padding:11px 8px;margin-top:10px;border:2px solid #6b7d52;border-radius:0;background:#29391e;color:#f5f2bf;font:700 13px "Courier New",monospace;letter-spacing:.5px;cursor:pointer;box-shadow:inset 3px 3px #435b32,inset -3px -3px #10190c,3px 3px #000;text-transform:uppercase}
.btn.primary{background:#5b4c18;color:#fff5b8;border-color:#9e8733;box-shadow:inset 3px 3px #88742c,inset -3px -3px #2f270b,3px 3px #000}.btn:disabled{opacity:.4;cursor:not-allowed}
.value-inline{color:var(--danger);margin-left:6px}.print-info{margin:8px 0 0;padding:8px;border:1px dashed #36513a;background:#081009;color:var(--muted);font-size:11px;line-height:1.5}.page-overlay{position:absolute;inset:22px;pointer-events:none;display:none}.page-overlay.show{display:block}.page-box{position:absolute;border:2px dashed rgba(255,241,132,.8);background:rgba(255,241,132,.025);box-shadow:inset 0 0 0 1px rgba(0,0,0,.55)}.page-box span{position:absolute;left:3px;top:3px;padding:2px 4px;background:#111b12;color:#fff1a0;font-size:10px;border:1px solid #786b2b}.toggle-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;border:1px solid #2b4230;padding:8px;background:#0a120b}.switch{position:relative;width:44px;height:24px;flex:none}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#111a12;border:2px solid #3c553d}.slider::before{content:"";position:absolute;width:14px;height:14px;left:3px;top:3px;background:#71806a;transition:.12s}.switch input:checked+.slider::before{transform:translateX(20px);background:var(--green)}
.preview{min-width:0;display:flex;flex-direction:column;gap:10px}.screen{min-height:520px;flex:1;display:flex;align-items:center;justify-content:center;overflow:auto;padding:22px;background:#030704;border:4px ridge #314732;position:relative;box-shadow:inset 0 0 35px #000,0 0 0 3px #060a07}
.screen::before{content:"MAP PREVIEW";position:absolute;left:10px;top:8px;color:#526c56;font-size:11px;letter-spacing:1px}.screen.crt-preview::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(to bottom,transparent 0 2px,rgba(0,0,0,.17) 2px 4px);mix-blend-mode:multiply}
canvas{display:block;max-width:none;background:#0c140e;box-shadow:0 0 0 3px #18261b,10px 10px 0 #000}.statusbar{display:flex;justify-content:space-between;gap:12px;align-items:center;min-height:40px;background:#0a120b;border:2px solid #2d4731;padding:8px 10px;color:var(--muted);font-size:12px}.led{display:inline-block;width:9px;height:9px;background:#495347;border:1px solid #0a0d09;margin-right:7px;box-shadow:0 0 0 1px #000}.led.on{background:var(--green);box-shadow:0 0 8px var(--green)}.kbd{color:var(--gold)}
@media(max-width:860px){.app{grid-template-columns:1fr}.sidebar{position:static;max-height:none}.screen{min-height:380px}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar pixel-box">
  <div class="titlebar"><h1>MAP GRID EDITOR</h1><div class="title-actions"><button id="crtBtn" class="crt-btn" type="button" aria-pressed="false">▤</button><button id="langBtn" class="flag-btn" type="button" aria-label="Switch language" title="English">🇬🇧</button></div></div>
  <p id="subtitle" class="subtitle"></p>
  <div id="drop" class="drop" role="button" tabindex="0"><span id="dropText"></span></div>
  <input id="file" class="file-input" type="file" accept="image/*">

  <div id="gridTitle" class="section-title"></div>
  <label for="cell"><span id="cellLabel"></span><span id="cellValue" class="value">100 px</span></label><input id="cell" type="range" min="10" max="500" value="100">
  <label for="zoom"><span id="zoomLabel"></span><span id="zoomValue" class="value">100%</span></label><input id="zoom" type="range" min="10" max="200" value="100" step="5">
  <div class="row"><div><label id="offsetXLabel" for="offsetX"></label><input id="offsetX" type="number" value="0"></div><div><label id="offsetYLabel" for="offsetY"></label><input id="offsetY" type="number" value="0"></div></div>
  <div class="row"><div><label id="lineWidthLabel" for="lineWidth"></label><input id="lineWidth" type="number" value="2" min="0.5" max="20" step="0.5"></div><div><label id="colorLabel" for="color"></label><input id="color" type="color" value="#000000"></div></div>
  <label for="opacity"><span id="opacityLabel"></span><span id="opacityValue" class="value">55%</span></label><input id="opacity" type="range" min="0" max="100" value="55">

  <div id="exportTitle" class="section-title"></div>
  <label id="formatLabel" for="format"></label><select id="format"><option value="image/png">PNG</option><option value="image/jpeg">JPEG</option><option value="image/webp">WebP</option></select>
  <button id="download" class="btn primary" disabled></button>

  <div id="printTitle" class="section-title"></div>
  <div class="row"><div><label id="paperLabel" for="paper"></label><select id="paper"><option value="a4">A4</option><option value="a3">A3</option></select></div><div><label id="orientationLabel" for="orientation"></label><select id="orientation"><option id="portraitOption" value="portrait"></option><option id="landscapeOption" value="landscape"></option></select></div></div>
  <div class="row"><div><label id="dpiLabel" for="printDpi"></label><input id="printDpi" type="number" value="100" min="20" max="1200" step="1"></div><div><label id="marginLabel" for="margin"></label><input id="margin" type="number" value="10" min="0" max="50" step="1"></div></div>
  <div class="toggle-row"><span id="pagePreviewLabel"></span><label class="switch"><input id="pagePreview" type="checkbox"><span class="slider"></span></label></div>
  <div id="printInfo" class="print-info"></div>
  <button id="pdfDownload" class="btn primary" disabled></button>
  <button id="reset" class="btn" type="button"></button>
</aside>
<main class="preview">
  <div id="screen" class="screen"><canvas id="canvas" width="960" height="540"></canvas><div id="pageOverlay" class="page-overlay"></div></div>
  <div class="statusbar"><span><span id="led" class="led"></span><span id="status"></span></span><span class="kbd">1 IN = DPI PX</span></div>
</main>
</div>
<script>
(()=>{
