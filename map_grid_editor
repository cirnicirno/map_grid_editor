function applyLang(){document.documentElement.lang=lang;$("langBtn").textContent=lang==="ru"?"🇬🇧":"🇷🇺";$("langBtn").title=lang==="ru"?"English":"Русский";const map={subtitle:"subtitle",gridTitle:"gridTitle",cellLabel:"cell",zoomLabel:"zoom",offsetXLabel:"offsetX",offsetYLabel:"offsetY",lineWidthLabel:"lineWidth",colorLabel:"color",opacityLabel:"opacity",exportTitle:"exportTitle",formatLabel:"format",printTitle:"printTitle",paperLabel:"paper",orientationLabel:"orientation",dpiLabel:"dpi",marginLabel:"margin",pagePreviewLabel:"pagePreview"};Object.entries(map).forEach(([id,key])=>$(id).textContent=t(key));$("portraitOption").textContent=t("portrait");$("landscapeOption").textContent=t("landscape");$("dropText").innerHTML=t("drop");download.textContent=t("download");pdfDownload.textContent=t("pdfDownload");$("reset").textContent=t("reset");updateCrtState();render()}
function placeholder(){canvas.width=960;canvas.height=540;canvas.style.width="min(960px, 100%)";canvas.style.height="auto";ctx.fillStyle="#071009";ctx.fillRect(0,0,960,540);ctx.strokeStyle="#29412e";ctx.lineWidth=4;ctx.strokeRect(24,24,912,492);ctx.fillStyle="#7cff75";ctx.textAlign="center";ctx.font="bold 28px Courier New";ctx.fillText(t("prompt"),480,270);$("status").textContent=t("upload");$("led").classList.remove("on");$("pageOverlay").classList.remove("show");$("printInfo").textContent="-"}
function printSettings(){const sizes={a4:[210,297],a3:[297,420]},paper=sizes[$("paper").value]||sizes.a4;let [wMm,hMm]=paper;if($("orientation").value==="landscape")[wMm,hMm]=[hMm,wMm];const margin=Math.max(0,+$("margin").value||0),dpi=Math.max(1,+$("printDpi").value||1),contentWMm=wMm-margin*2,contentHMm=hMm-margin*2;if(contentWMm<=0||contentHMm<=0)return null;const tileW=Math.max(1,Math.floor(contentWMm/25.4*dpi)),tileH=Math.max(1,Math.floor(contentHMm/25.4*dpi)),cols=image?Math.ceil(canvas.width/tileW):0,rows=image?Math.ceil(canvas.height/tileH):0;return{wMm,hMm,margin,dpi,contentWMm,contentHMm,tileW,tileH,cols,rows,pages:cols*rows}}
function updatePageOverlay(){const overlay=$("pageOverlay"),ps=printSettings();overlay.innerHTML="";if(!image||!ps||!$("pagePreview").checked){overlay.classList.remove("show");return}overlay.classList.add("show");const displayedW=parseFloat(canvas.style.width)||canvas.width,displayedH=parseFloat(canvas.style.height)||canvas.height,sx=displayedW/canvas.width,sy=displayedH/canvas.height;overlay.style.width=displayedW+"px";overlay.style.height=displayedH+"px";overlay.style.left=`calc(50% - ${displayedW/2}px)`;overlay.style.top=`calc(50% - ${displayedH/2}px)`;let n=1;for(let r=0;r<ps.rows;r++)for(let c=0;c<ps.cols;c++){const d=document.createElement("div");d.className="page-box";d.style.left=(c*ps.tileW*sx)+"px";d.style.top=(r*ps.tileH*sy)+"px";d.style.width=(Math.min(ps.tileW,canvas.width-c*ps.tileW)*sx)+"px";d.style.height=(Math.min(ps.tileH,canvas.height-r*ps.tileH)*sy)+"px";const label=document.createElement("span");label.textContent=n++;d.appendChild(label);overlay.appendChild(d)}}
function render(){$("cellValue").textContent=$("cell").value+" px";$("zoomValue").textContent=$("zoom").value+"%";$("opacityValue").textContent=$("opacity").value+"%";if(!dpiTouched)$("printDpi").value=$("cell").value;if(!image){placeholder();return}canvas.width=image.naturalWidth;canvas.height=image.naturalHeight;const z=+$("zoom").value/100;canvas.style.width=Math.round(canvas.width*z)+"px";canvas.style.height=Math.round(canvas.height*z)+"px";ctx.clearRect(0,0,canvas.width,canvas.height);ctx.drawImage(image,0,0);const cell=Math.max(1,+$("cell").value),ox=mod(+$("offsetX").value||0,cell),oy=mod(+$("offsetY").value||0,cell),w=Math.max(.5,+$("lineWidth").value||1);ctx.save();ctx.strokeStyle=rgba($("color").value,+$("opacity").value/100);ctx.lineWidth=w;ctx.beginPath();for(let x=ox;x<=canvas.width;x+=cell){ctx.moveTo(Math.round(x)+.5,0);ctx.lineTo(Math.round(x)+.5,canvas.height)}for(let y=oy;y<=canvas.height;y+=cell){ctx.moveTo(0,Math.round(y)+.5);ctx.lineTo(canvas.width,Math.round(y)+.5)}ctx.stroke();ctx.restore();$("status").textContent=`${t("loaded")} // ${canvas.width}×${canvas.height} PX // ${Math.ceil(canvas.width/cell)}×${Math.ceil(canvas.height/cell)} ${t("cells")}`;$("led").classList.add("on");const ps=printSettings();$("printInfo").textContent=ps?`${t("pages")}: ${ps.pages} (${ps.cols}×${ps.rows}) // ${t("printArea")}: ${ps.contentWMm.toFixed(0)}×${ps.contentHMm.toFixed(0)} MM // ${ps.tileW}×${ps.tileH} PX`:t("invalidPrint");updatePageOverlay()}
